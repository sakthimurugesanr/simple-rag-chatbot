# Paths are relative to the project root, even when invoked from another directory.
RAG_DATA_DIR=data
RAG_MAX_UPLOAD_MB=25
RAG_MAX_ARCHIVE_MB=100
RAG_MAX_EXTRACTED_CHARS=5000000
RAG_MAX_PDF_PAGES=1000
RAG_MAX_TABLE_ROWS=100000
RAG_TABLE_ROWS_PER_BLOCK=20
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_LOG_LEVEL=INFO
RAG_OCR_ENABLED=false
RAG_OCR_LANGUAGE=eng
RAG_OCR_DPI=200
RAG_OCR_TIMEOUT_SECONDS=60
# Optional absolute paths if Poppler/Tesseract are not on PATH:
# RAG_POPPLER_PATH=C:/tools/poppler/Library/bin
# RAG_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# OpenRouter chat UI. Embedding fields are reserved for semantic retrieval later.
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_LLM_PROVIDER=openrouter
RAG_LLM_MODEL=google/gemma-4-31b-it:free
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_TEMPERATURE=0.2
RAG_MAX_TOKENS=1024
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25
RAG_COLLECTION=documents
# RAG_OPENAI_API_KEY=
# RAG_GEMINI_API_KEY=
# RAG_OPENROUTER_API_KEY=
# RAG_ANTHROPIC_API_KEY=
# RAG_GROQ_API_KEY=
